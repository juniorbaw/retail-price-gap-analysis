# Normalisation des fins de ligne : LF dans le depot, natif au checkout.
* text=auto eol=lf

# Donnees tabulaires : traitees comme du texte pour que les diffs restent lisibles.
*.csv text eol=lf
*.tsv text eol=lf

# Exception : les sources brutes ne sont JAMAIS normalisees. Elles doivent rester
# identiques a l'octet pres au fichier d'origine (CRLF inclus), sinon leur
# empreinte md5 change et la tracabilite est perdue.
02-fashion-retail-analytics/data/raw/** -text

# Code et configuration
*.py    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
Makefile text eol=lf

# Notebooks : JSON, mais on evite les conversions destructrices.
*.ipynb text eol=lf

# Binaires : jamais de conversion de fins de ligne.
*.parquet binary
*.png     binary
*.jpg     binary
*.pdf     binary
*.pbix    binary
*.duckdb  binary
